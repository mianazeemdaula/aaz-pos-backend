# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/coldstorage

# Database Backup Configuration
# Backups are created with pg_dump. The server finds the PostgreSQL client tools
# automatically (installer registry entry on Windows, standard paths elsewhere).
# Set this only if pg_dump lives somewhere unusual — it must be the folder that
# contains pg_dump, pg_restore and psql.
# PG_BIN_DIR=D:\installations\postgreSQL\16\bin

# Server Configuration
PORT=4001
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-this-in-production

# Auto-Update Configuration
# Point this to a JSON manifest file you host (e.g. on GitHub Releases, your own server, etc.)
# Leave empty or omit to disable automatic update checks.
# Manifest format:
#   { "version": "1.0.0", "url": "https://example.com/cold-storage-1.0.0.exe", "notes": "..." }
UPDATE_CHECK_URL=https://pos.txdevs.com/public/backend.json
